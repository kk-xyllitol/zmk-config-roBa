#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    arrows {
        layers = <3>;
        bindings =
            <&kp RIGHT_ARROW>,
            <&kp LEFT_ARROW>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;

        tick = <10>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_mac {
            bindings = <
&kp Q        &kp W         &kp E             &kp R               &kp T                                          &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LCTRL A  &kp S         &kp D             &kp F               &kp G        &kp LS(LG(S))      &kp SEMI       &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z        &kp X         &kp C             &kp V               &lt 4 B      &trans             &kp SLASH      &kp N        &kp M  &kp COMMA  &kp DOT  &kp EQUAL
&kp LSHIFT   &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_GUI LANG1  &lt 3 SPACE  &kp TAB            &kp BACKSPACE  &lt 2 ENTER                             &kp RC(RS(NUMBER_4))
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PG_UP>;
        };

        default_win {
            bindings = <
&kp Q        &kp W         &kp E         &kp R                   &kp T                                          &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LCTRL A  &kp S         &kp D         &kp F                   &kp G        &kp LS(LG(S))      &kp SEMI       &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z        &kp X         &kp C         &kp V                   &lt 4 B      &trans             &kp SLASH      &kp N        &kp M  &kp COMMA  &kp DOT  &kp EQUAL
&kp LSHIFT   &kp LEFT_ALT  &kp LEFT_GUI  &mt LEFT_CONTROL LANG1  &lt 3 SPACE  &kp TAB            &kp BACKSPACE  &lt 2 ENTER                             &kp LG(LS(S))
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PG_UP>;
        };

        NUM {
            bindings = <
&kp SQT        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp LEFT_PARENTHESIS                                       &kp RIGHT_PARENTHESIS  &none     &none         &none      &trans
&kp GRAVE      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6    &kp LEFT_BRACKET      &kp LC(LA(KP_NUMBER_0))      &trans  &kp RIGHT_BRACKET      &none     &kp UP_ARROW  &none      &trans
&kp BACKSLASH  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9    &kp LEFT_BRACE        &tog 0                       &trans  &kp RIGHT_BRACE        &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&trans         &kp NUMBER_0  &trans        &kp LANGUAGE_2  &trans                &trans                       &trans  &trans                                                    &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &kp PAGE_UP    &trans  &trans                      &trans  &kp ESCAPE    &kp RC(UP_ARROW)    &trans         &trans
&trans  &trans  &kp PAGE_DOWN  &trans  &trans  &trans      &trans  &trans  &kp RC(LEFT)  &kp RC(DOWN_ARROW)  &kp RC(RIGHT)  &trans
&trans  &trans  &trans         &trans  &trans  &trans      &trans  &trans  &trans        &trans              &trans         &trans
&trans  &trans  &trans         &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans          &trans          &kp PAGE_UP      &trans                         &kp F1  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2     &kp F5
&trans  &trans          &kp UP_ARROW    &kp PAGE_DOWN    &kp HOME  &trans      &kp F13  &kp F6  &bt BT_SEL 3    &kp UP_ARROW    &kp F9           &kp F10
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END   &trans      &trans   &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F11
&trans  &trans          &trans          &trans           &trans    &trans      &trans   &trans                                                   &kp F12
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};
